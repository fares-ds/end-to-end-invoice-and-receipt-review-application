# Ollama server. Nothing here is a secret, but the default model is cloud-served
# and needs a signed-in Ollama account with a subscription.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma4:cloud

# To run fully offline instead, use a local model. Expect lower accuracy: on the
# 13-document corpus gemma3:1b scores 93.5% and misclassifies receipts.
# OLLAMA_MODEL=gemma3:1b

# How structured output is requested. "auto" prompts :cloud models for JSON and
# lets locally-served models be grammar-constrained. Override only if a model
# behaves differently: auto | native | prompted
# OLLAMA_OUTPUT_MODE=auto

# Local OCR. Requires poppler and tesseract on PATH.
OCR_LANGUAGES=eng+nld+deu+fra

# Optional shared-password gate (leave unset for local development)
# APP_ACCESS_PASSWORD=replace-with-demo-password
# APP_SESSION_SECRET=replace-with-long-random-secret
# ALLOWED_ORIGIN=http://localhost:5173
