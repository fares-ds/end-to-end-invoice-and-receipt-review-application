# Local Ollama server. Nothing here is a secret and no account is required.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:1b

# Optional. Set to a vision-capable model (for example qwen2.5vl:3b) to have the
# independent document review read the page image instead of the OCR text.
# Leave unset on machines without spare memory.
# OLLAMA_VISION_MODEL=

# Local OCR. Requires poppler and tesseract on PATH.
OCR_LANGUAGES=eng+nld+deu+fra

# Optional shared-password gate (leave unset for local development)
# APP_ACCESS_PASSWORD=replace-with-demo-password
# APP_SESSION_SECRET=replace-with-long-random-secret
# ALLOWED_ORIGIN=http://localhost:5173
